# Data (large, re-downloadable)
data/*
!data/val_ids_v2.parquet        # frozen validation list: must be versioned
kaggle_upload/*
# Frozen V27 artifacts from Kaggle (pool npz, FPNet, rankers, RDKit wheel)
artifacts/*

# Caches and run outputs
cache/
experiments/*/results/
experiments/*/run.log

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Secrets (just in case)
.kaggle/
kaggle.json
access_token
# Root-level text files (run outputs, logs)
/*.txt
